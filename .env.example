# ---- Required: Supabase project (free tier works for staging) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server-only secrets (never prefix with NEXT_PUBLIC_) ----
# Needed for account deletion and auth-level bans. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=
# Enables the AI preparedness assistant. Without it the assistant shows an "unavailable" state.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-5-5)
AI_MODEL=

# ---- Tests ----
# Local PostgreSQL used by `npm run test:db` and `npm run check:queries`
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/vanguard_test
# Chrome/Chromium binary for Playwright (`npm run test:e2e`)
CHROME_PATH=/usr/bin/google-chrome
